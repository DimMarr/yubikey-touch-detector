# Maintainer: Dimitri Martel <martel.dimitri34@gmail.com>
pkgname=yubikey-touch-detector
pkgver=0.1.0
pkgrel=1
pkgdesc="Detects when a YubiKey is waiting for a touch, and notifies other programs about it"
arch=('x86_64' 'aarch64')
url="https://github.com/DimMarr/yubikey-touch-detector"
# Real, recognized SPDX-adjacent Arch license identifiers - not 'custom',
# since MIT and Apache-2.0 are both in Arch's standard license list.
license=('MIT' 'Apache-2.0')

# Deliberately empty: this Rust rewrite has NO runtime C library
# dependencies. In particular there is no `gpgme` dependency, unlike what an
# AUR package for the original Go-based maximbaz/yubikey-touch-detector would
# have needed (it links libgpgme via cgo to talk to gpg-agent). This rewrite
# reimplements the small slice of the Assuan protocol it needs natively in
# Rust (see src/assuan/ upstream), so gpgme never enters the picture. The
# D-Bus notifier/detector uses zbus, a pure-Rust D-Bus implementation that
# doesn't link libdbus either.
depends=()

makedepends=('cargo' 'scdoc')

source=("$pkgname-$pkgver.tar.gz::https://github.com/DimMarr/yubikey-touch-detector/archive/v$pkgver.tar.gz")
# Placeholder: v$pkgver doesn't exist yet as a real GitHub release/tag, so a
# real checksum can't be computed. Replace with the actual sha256sum of the
# release tarball (e.g. via `updpkgsums`) once v$pkgver is tagged and
# published.
sha256sums=('REPLACE_WITH_REAL_SHA256')

# Cargo.lock is already tracked in this repo, which is what makes
# `--locked` below reproducible: every dependency version is pinned exactly
# to what was tested upstream. AUR builds (unlike Arch's official
# core/extra repositories) are explicitly allowed network access during
# `makepkg` - see https://wiki.archlinux.org/title/Arch_package_guidelines -
# so there's no need for a vendoring step here; `cargo build --locked` will
# simply fetch the pinned crates.io dependencies at build time.
build() {
	cd "$pkgname-$pkgver"
	cargo build --release --locked
	scdoc < "$pkgname.1.scd" > "$pkgname.1"
}

check() {
	cd "$pkgname-$pkgver"
	cargo test --release --locked
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
	install -Dm644 "$pkgname.1" "$pkgdir/usr/share/man/man1/$pkgname.1"
	install -Dm644 "$pkgname.service" "$pkgdir/usr/lib/systemd/user/$pkgname.service"
	install -Dm644 "$pkgname.socket" "$pkgdir/usr/lib/systemd/user/$pkgname.socket"
	install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
	install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
	install -Dm644 service.conf.example "$pkgdir/usr/share/doc/$pkgname/service.conf.example"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
